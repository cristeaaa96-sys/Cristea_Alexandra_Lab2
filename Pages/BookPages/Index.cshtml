@page "/"
@model Cristea_Alexandra_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form method="get">
    <div class="form-group">
        <label>Find by Book Title / Author Name:</label>

        <input type="text"
               name="searchString"
               value="@Model.CurrentFilter"
               class="form-control"
               style="display:inline-block; width:250px;" />

        <input type="submit"
               value="Search"
               class="btn btn-primary" />

        <a asp-page="./Index">Back to Full List</a>
    </div>
</form>


<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.TitleSort">
                    Book Title
                </a>
            </th>

            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.AuthorSort">
                    LastName
                </a>
            </th>

            <th>Price</th>
            <th>PublishingDate</th>
            <th>PublisherName</th>
            <th>BookCategories</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            string selectedRow = "";

            if (item.ID == Model.BookID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @item.Authors?.LastName
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>

                <td>
                    @item.Publisher?.PublisherName
                </td>

                <td>
                    @if (item.BookCategories != null)
                    {
                        foreach (var bc in item.BookCategories)
                        {
                            <div>
                                @bc.Category?.ID -
                                @bc.Category?.CategoryName
                            </div>
                        }
                    }
                </td>

                <td>
                    <a asp-page="./Index"
                       asp-route-id="@item.ID">Select</a> |

                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
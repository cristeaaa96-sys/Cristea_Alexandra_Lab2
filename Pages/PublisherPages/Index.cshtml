@page "{id:int?}"
@model Cristea_Alexandra_Lab2.Pages.PublisherPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>PublisherName</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.PublisherData.Publishers)
        {
            string selectedRow = "";

            if (item.ID == Model.PublisherID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.PublisherName)
                </td>

                <td>
                    <a asp-page="./Index"
                       asp-route-id="@item.ID">Select</a> |

                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.PublisherID != 0)
{
    <h3>Books Edited by Selected Publisher</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Author</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model.PublisherData.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Authors?.FullName</td>
                </tr>
            }
        </tbody>
    </table>
}
